# Contact form (app/api/contact/route.ts) — uses the Resend email API.
# 1) Create a free account at resend.com and an API key.
# 2) With the default sender below, Resend only delivers to the email you signed up with.
#    To send to any address, verify your own domain in Resend and set CONTACT_FROM_EMAIL.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ptech8000@gmail.com
# CONTACT_FROM_EMAIL="P-TECH Website <contact@yourdomain.com>"
